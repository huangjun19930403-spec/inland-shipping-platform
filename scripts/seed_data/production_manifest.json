    },
    {
      "resource": "commodity_types",
      "path": "scripts/seed_data/commodity/commodity_types.json",
      "loader": "scripts.seeds.loaders.commodity_taxonomy.seed_commodity_taxonomy"
    },
    {
      "resource": "commodity_standards",
      "path": "scripts/seed_data/commodity/commodity_standards.json",
      "loader": "scripts.seeds.loaders.commodity_standards.seed_commodity_standards"
    },
    {
      "resource": "business_regions",
      "path": "scripts/seed_data/address/business_regions.json",
      "loader": "scripts.seeds.loaders.business_regions.seed_business_regions"
    },
    {
      "resource": "transport_nodes",
      "path": "scripts/seed_data/address/transport_nodes.json",
      "loader": "scripts.seeds.loaders.transport_nodes.seed_transport_nodes"
    },
    {
      "resource": "production_vessels",
      "path": "scripts/seed_data/vessel/production_vessels.json",
      "loader": "scripts.seeds.loaders.production_vessels.seed_production_vessels"
