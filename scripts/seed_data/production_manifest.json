{
  "schema_version": 1,
  "profile": "production",
  "description": "Production seed reads only curated result data files listed here.",
  "resources": [
    {
      "resource": "admin_regions",
      "path": "scripts/seed_data/admin_region/admin_region_raw.json",
      "loader": "scripts.seeds.loaders.admin_regions.seed_admin_regions"
    },
    {
      "resource": "admin_region_city_boundaries",
      "path": "scripts/seed_data/admin_region/admin_region_boundary_city_raw.json",
      "loader": "scripts.seeds.loaders.admin_regions.seed_admin_regions"
    },
    {
      "resource": "navigation_channels",
      "path": "scripts/seed_data/navigation/navigation_channels.json",
      "loader": "scripts.seeds.loaders.navigation_channels.seed_navigation_channels"
    },
    {
      "resource": "navigation_water_areas",
      "path": "scripts/seed_data/navigation/navigation_water_areas.jsonl.gz",
      "loader": "scripts.seeds.loaders.navigation_water_areas.seed_navigation_water_areas"
    },
    {
      "resource": "navigation_water_areas_manifest",
      "path": "scripts/seed_data/navigation/navigation_water_areas_manifest.json",
