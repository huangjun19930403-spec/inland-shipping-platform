# ─────────────────────────────────────────────────────────────────────
# 中国内河航运数据采集与分析平台 — 环境变量模板
# 使用方式：cp .env.example .env，然后填写实际值
# 警告：.env 文件不能提交到 Git！
# ─────────────────────────────────────────────────────────────────────

# ─── 应用基础配置 ────────────────────────────────────────────────────
APP_NAME=中国内河航运数据采集与分析平台
APP_VERSION=2.0.0
DEBUG=true                          # 生产环境设为 false

# ─── 数据库配置 ──────────────────────────────────────────────────────
# 开发环境（SQLite，无需安装数据库）
DATABASE_URL=sqlite+aiosqlite:///./inland_shipping.db

# 生产环境（PostgreSQL，取消注释并填写实际值）
# DATABASE_URL=postgresql+asyncpg://inland_user:PASSWORD@localhost:5432/inland_shipping

# ─── JWT认证配置 ─────────────────────────────────────────────────────
# 生产环境必须使用强随机密钥！
# 生成命令：python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=inland-shipping-platform-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440    # 24小时

# ─── AI服务配置 ──────────────────────────────────────────────────────
# 从 https://console.anthropic.com 获取 API Key
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=claude-sonnet-4-6
AI_CONFIDENCE_THRESHOLD=60          # 实体匹配最低置信度（0-100）

# ─── Celery任务队列（生产环境需要Redis）─────────────────────────────
# 开发环境可不配置，使用APScheduler
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── 定时任务调度 ────────────────────────────────────────────────────
STATS_CRON_SCHEDULE=0 2 * * *      # 每日凌晨2点执行统计聚合（cron格式）
STATS_CRON_HOUR=2                   # APScheduler兼容配置
STATS_CRON_MINUTE=0

# ─── CORS跨域配置 ────────────────────────────────────────────────────
# 开发环境允许所有来源
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
# 生产环境替换为实际前端域名
# ALLOWED_ORIGINS=["https://your-domain.com"]
