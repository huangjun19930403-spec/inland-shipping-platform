APP_NAME=Inland Shipping Platform
APP_VERSION=3.0.0-non-ai-baseline
DEBUG=true

# sqlite example:
# DATABASE_URL=sqlite+aiosqlite:///./inland_shipping.db
# mysql example:
# DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/inland_shipping?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./inland_shipping.db

SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

ES_TIMEOUT_SECONDS=10
ES_HISTORY_TIMEOUT_SECONDS=30
ES_R_SCHEME=http
ES_R_HOST=
ES_R_PORT=80
ES_R_USER=elastic
ES_R_PASSWORD=
ES_R_INDEX=ship_positions
ES_SCHEME=http
ES_HOST=
ES_PORT=80
ES_USER=elastic
ES_PASSWORD=
ES_HISTORY_INDEX_PREFIX=ship_locations_

ROUTE_GEOMETRY_MODE=real
ROUTE_GEOMETRY_TIMEOUT_SECONDS=8
ROUTE_AMAP_WEB_API_KEY=
AMAP_JS_API_KEY=
AMAP_SECURITY_JS_CODE=

HIFLEET_ENABLED=false
HIFLEET_BASE_URL=https://www.hifleet.com
HIFLEET_LOGIN_URL=/hifleetapi/generalUserLoginAction.do
HIFLEET_ROUTE_URL=/hifleetrouteapi/getNewRoute
HIFLEET_CHECK_LOGIN_URL=/hifleetapi/queryAlertRsCount.do
HIFLEET_USERNAME=
HIFLEET_PASSWORD=
HIFLEET_TIMEOUT_SECONDS=8
HIFLEET_RELOGIN_CHECK_ENABLED=true

AI_PROVIDER=DASHSCOPE_QWEN
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_TIMEOUT_SECONDS=30

# container startup controls (entrypoint)
WAIT_FOR_DB_ON_START=true
DB_WAIT_MAX_RETRIES=30
DB_WAIT_INTERVAL_SECONDS=2
RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true
UVICORN_PORT=8000
UVICORN_LOG_LEVEL=info
